# Novae Conseil — environment variables
# Copy to backend/.env and adjust values for local dev.
# Never commit backend/.env.

# Application
APP_NAME="Novae Conseil"

# Database
DATABASE_URL=sqlite:///./novae.db

# Rate limiting (per-IP)
# Production defaults: 1 per second, 10 per day
# Raise these for local dev / Playwright runs.
RATE_LIMIT_PER_SECOND=1
RATE_LIMIT_PER_DAY=10